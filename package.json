{
  "name": "abcdesk",
  "displayName": "ABC Desk",
  "description": "A practice-oriented ABC music workbench: score preview, playback and a file-based practice loop.",
  "version": "0.0.1",
  "publisher": "abcdesk",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:abc"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "abcdesk.openPreviewToSide",
        "title": "%abcdesk.command.openPreviewToSide.title%",
        "category": "ABC Desk",
        "icon": "$(open-preview)"
      },
      {
        "command": "abcdesk.togglePlayback",
        "title": "%abcdesk.command.togglePlayback.title%",
        "category": "ABC Desk"
      },
      {
        "command": "abcdesk.stop",
        "title": "%abcdesk.command.stop.title%",
        "category": "ABC Desk"
      },
      {
        "command": "abcdesk.playFromCursor",
        "title": "%abcdesk.command.playFromCursor.title%",
        "category": "ABC Desk"
      },
      {
        "command": "abcdesk.playFromSelectedNote",
        "title": "%abcdesk.command.playFromSelectedNote.title%",
        "category": "ABC Desk"
      },
      {
        "command": "abcdesk.goToSource",
        "title": "%abcdesk.command.goToSource.title%",
        "category": "ABC Desk",
        "icon": "$(go-to-file)"
      },
      {
        "command": "abcdesk.exportMidi",
        "title": "%abcdesk.command.exportMidi.title%",
        "category": "ABC Desk"
      },
      {
        "command": "abcdesk.exportSvg",
        "title": "%abcdesk.command.exportSvg.title%",
        "category": "ABC Desk"
      }
    ],
    "configuration": {
      "title": "ABC Desk",
      "properties": {
        "abcdesk.rememberPracticeSettings": {
          "type": "boolean",
          "default": true,
          "description": "%abcdesk.configuration.rememberPracticeSettings.description%"
        }
      }
    },
    "languages": [
      {
        "id": "abc",
        "extensions": [".abc"]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "abcdesk.openPreviewToSide",
          "when": "resourceLangId == abc",
          "group": "navigation"
        },
        {
          "command": "abcdesk.goToSource",
          "when": "activeWebviewPanelId == abcdesk.preview",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "abcdesk.openPreviewToSide",
          "when": "resourceExtname == .abc"
        }
      ],
      "editor/context": [
        {
          "command": "abcdesk.playFromCursor",
          "when": "resourceLangId == abc",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "spec:check": "node scripts/spec-check.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run spec:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.75.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "abcjs": "^6.7.1"
  }
}
